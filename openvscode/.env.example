# OpenVSCode Server Environment Configuration
# Copy this file to .env and customize as needed

# Node Environment
NODE_ENV=development
# NODE_ENV=production

# Server Configuration
HOST=0.0.0.0
PORT=9000

# Workspace Path (inside container)
WORKSPACE_DIR=/workspace

# Debug Mode (set to false in production)
DEBUG=true
# DEBUG=false

# VS Code Extensions Path (optional)
# EXTENSIONS_PATH=/app/extensions

# Language Server Configuration
# ENABLE_LANGUAGE_SERVERS=true

# Terminal Configuration
# SHELL=/bin/bash
# SHELL_ARGS=-i

# Workspace Settings
# WORKSPACE_NAME=OpenVSCode Workspace
# WORKSPACE_MOUNT_PATH=/home/workspace

# Features
# ENABLE_BUILTIN_EXTENSIONS=true
# ENABLE_PROPOSED_API=false

# Performance
# MAX_MEMORY=2048
# MAX_OLD_SPACE_SIZE=4096

# Proxy Configuration (if behind a corporate proxy)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# SSL/TLS Configuration
# SSL_ENABLED=false
# SSL_CERT_PATH=/etc/nginx/certs/cert.pem
# SSL_KEY_PATH=/etc/nginx/certs/key.pem

# Authentication (if using reverse proxy with auth)
# AUTH_REQUIRED=false
# AUTH_TOKEN=

# Logging
# LOG_LEVEL=info
# LOG_FILE=/var/log/openvscode-server.log

# Docker Specific
# DOCKER_BUILD_KIT=1
# DOCKER_BUILDKIT=1
